{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(./scripts/verify-fast.sh *)",
      "Bash(./scripts/verify-full.sh *)",
      "Bash(./scripts/check-no-secrets.sh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./backups/**)",
      "Read(./exports/**)",
      "Read(./logs/production/**)",
      "Read(./data/production/**)",
      "Read(./customer-data/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./credentials/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Write(./credentials/**)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(kubectl *)",
      "Bash(terraform apply *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_edit.py"
          }
        ]
      }
    ]
  }
}
